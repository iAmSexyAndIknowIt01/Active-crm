# PostgreSQL (Supabase). Локал PostgreSQL бол DATABASE_SSL=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/activecrm
DATABASE_SSL=false
DB_POOL_MAX=5

# 32+ тэмдэгт санамсаргүй утга: openssl rand -base64 48
SESSION_SECRET=

# Имэйл (Gmail App Password). Хоосон бол dev орчинд console-д хэвлэнэ
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Сануулга: cron-ийн нууц түлхүүр, SMS gateway (заавал биш)
CRON_SECRET=
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=

# Proxy-гүй локал орчинд 0
TRUSTED_PROXY_HOPS=0
